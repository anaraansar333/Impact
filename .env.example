# Скопируйте в .env и заполните. Файл .env в git НЕ коммитится.

# --- Ключи провайдеров ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=

# --- Hugging Face (публикация датасета, неделя 9-10) ---
HF_TOKEN=
HF_DATASET_REPO=

# --- Пайплайн ---
# Ограничение запросов в минуту на одного провайдера (клиентский троттлинг)
DEFAULT_RPM=30
# Сколько раз повторять запрос при 429 / 5xx / сетевой ошибке
MAX_RETRIES=6
# Максимальная пауза между повторами, секунд
MAX_BACKOFF_S=90
# Куда писать логи прогонов (JSONL)
LOG_DIR=runs
