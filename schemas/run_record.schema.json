{
  "$defs": {
    "AnswerCheck": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "got": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Got"
        },
        "unit_got": {
          "default": "",
          "title": "Unit Got",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Авто-подсказка разметчику: SIGN / DIM / MISSING",
          "title": "Hint"
        }
      },
      "required": [
        "name",
        "expected",
        "ok"
      ],
      "title": "AnswerCheck",
      "type": "object"
    },
    "ModelAnswer": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "ModelAnswer",
      "type": "object"
    }
  },
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "prompt_variant": {
      "title": "Prompt Variant",
      "type": "string"
    },
    "prompt_hash": {
      "title": "Prompt Hash",
      "type": "string"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "response_text": {
      "default": "",
      "title": "Response Text",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
