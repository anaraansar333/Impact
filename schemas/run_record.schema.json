    },
    "checks": {
      "items": {
        "$ref": "#/$defs/AnswerCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "correct": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correct"
    },
    "usage": {
      "additionalProperties": true,
      "title": "Usage",
      "type": "object"
    },
